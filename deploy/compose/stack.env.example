# The whole stack's addresses, in one file.
#
# Copy to `stack.env` and edit. Nothing else in the repo should carry a hostname that an
# operator is expected to change. Founder, 2026-08-18: "we also need to be able to change
# domain names, we are secrets etc" - so a rename is this file plus a DNS record, not a
# search across five fly.tomls and two Next configs.
#
# Secrets do NOT go here. They come from ../../.env (and from `fly secrets` in production).
# This file is safe to commit as an example and is git-ignored as `stack.env`.

# The storefront the buyer types.
SITE_DOMAIN=mumchimp.com
# The API the storefront and the engine call.
API_DOMAIN=api.mumchimp.com
# http for a laptop run with no certificate, https everywhere else.
SITE_SCHEME=https

# The edge: what the world types, and whether Caddy manages a certificate for it.
#
# A BARE hostname means Caddy requests and renews a Let's Encrypt certificate for it. An
# explicit `http://` scheme means no TLS at all, which is the only thing that works on a
# laptop with no public DNS. The defaults in docker-compose.yml are the http:// pair, so an
# operator who never copies this file cannot point a drill at Let's Encrypt and spend the
# five-per-week duplicate-certificate limit on a domain they do not control.
#
# Production, on a rented box whose public IP the DNS record already points at:
#   EDGE_SITE=mumchimp.com, www.mumchimp.com
#   EDGE_API=api.mumchimp.com
#   ACME_EMAIL=you@example.com
#
# The local drill:
EDGE_SITE=http://localhost
EDGE_API=http://api.localhost
ACME_EMAIL=

# Ports published on the host when running locally. Change these, not the container ports.
# 80 and 443 are the edge's, and 80 is not optional in production: it carries the HTTP-01
# challenge Caddy answers to get the certificate, and the redirect to 443.
WEB_PORT=3000
API_PORT=5291
CONSOLE_PORT=8611
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# How many CI runners to bring up with the `ci` profile.
RUNNER_LABELS=self-hosted,macOS,ARM64
