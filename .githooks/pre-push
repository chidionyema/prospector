#!/usr/bin/env bash
# Local mirror of the CI "guard" job: catch silent deletion of protected files BEFORE you push,
# instead of finding out when the PR goes red.
#
# Opt in (one time, per clone):
#     git config core.hooksPath .githooks
#
# It compares your branch against origin/main and blocks the push if a protected path (see
# .protected-paths) is being deleted without a `Removes:` trailer in a commit message.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

base="origin/main"
git rev-parse --verify --quiet "$base" >/dev/null || { echo "guard: no $base to compare against; skipping."; exit 0; }

# git hands the refs being pushed on STDIN, and stdin can only be read once. Capture it first,
# then feed each guard its own copy — a guard that reads an empty push inspects nothing and passes
# every time.
refs="$(cat)"

# Worktrees share ONE hooks directory (it lives in the common git dir), so this hook also runs in
# trees created before the guard existed. Refusing loudly beats skipping quietly: a tree that old
# is also a tree whose base is stale.
if [ ! -f scripts/guard_dead_branch_push.py ]; then
  echo "pre-push blocked: this tree predates scripts/guard_dead_branch_push.py."
  echo "Rebase it:  git fetch origin main && git rebase origin/main"
  echo "Or push anyway:  ALLOW_BRANCH_RECREATE=1 git push ..."
  [ "${ALLOW_BRANCH_RECREATE:-}" = "1" ] || exit 1
fi

if [ -f scripts/guard_dead_branch_push.py ] && ! printf "%s" "$refs" | python3 scripts/guard_dead_branch_push.py; then
  echo ""
  echo "pre-push blocked: this push would recreate a branch a merge already deleted."
  exit 1
fi

if ! python3 scripts/guard_protected_deletions.py "$base"; then
  echo ""
  echo "pre-push blocked by protected-deletion guard. See message above."
  exit 1
fi
