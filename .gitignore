# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets
# Ignore every .env variant, then re-admit the committed *.example templates. The previous
# list named only `.env` and `.env.local`, which left store_platform/.env.production — the
# file that holds the LIVE Stripe keys — fully committable.
.env
.env.*
!.env*.example
!*.env.example
*.pem
*.key

# Prospector-specific
store/_cache/
store/dossiers/
store/runs/
store/listings/
store/*.db
# `store/*.db` does not catch a suffixed backup: store/prospector.db.pre-market.bak is a
# 920K sqlite index of 1286 candidate titles + kill decisions. It is not the paid pack
# content (that lives in store/dossiers/, ignored above), but it is the whole idea
# pipeline and it embeds local absolute paths — and this repo is public.
store/*.db.*
store/*.bak

# Per-run local state, regenerated on every run; never source.
store/.cli_slots/
store/control_center/runs/
store/markets/*/probe/
store/markets/*/probe.pid
store/markets/*/probe_run.log

# Logs
*.log

# Runtime audit/telemetry artifacts (regenerated every run)
store/*.jsonl
store/golden_runs/
publish/bundles/
.aider*

# .NET build output (store_platform)
[Bb]in/
[Oo]bj/
provider_health.json
.agent/
.checkpoints/

# Local dev content store (deliverables synced from publish/bundles; never commit binaries)
content_store/
store_platform/src/Store.Api/content_store/

# Throwaway virtualenvs
.venv*/

# local test stack runtime (logs + pids)
store_platform/.test-stack/

# verify_delivery.py state — holds live entitlement grant tokens, which are bearer
# credentials for a paid download (/download/{token} needs nothing else)
store_platform/.delivery-proof/

# Agent/keystore scratch — NEVER commit (.lux/keys holds a private agent.pem)
.lux/
.pi/

# Editor backups + SQLite write-ahead/shared-memory sidecars
*.save
*.db-wal
*.db-shm

# Scheduler runtime state (heartbeat, tick log, kill switch) — machine-local, not source
store/scheduler/heartbeat.json
store/scheduler/ticks.jsonl
store/scheduler/PAUSE
store/scheduler/alerts.jsonl
store/scheduler/ALERT.txt
store/scheduler/alert_state.json
store/scheduler/watchdog.*.log
store/scheduler/launchd.*.log
