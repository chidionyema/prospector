# Store.Api — PRODUCTION environment (live money path).
#
# Copy to store_platform/.env.production and fill in the real values, then run:
#   bash store_platform/scripts/go_live.sh
# .env.production is gitignored. NEVER commit real keys. Rotate immediately if leaked.
#
# Every key below is REQUIRED for a live Stripe cutover. MoneyRailConfigGate
# (a fail-closed boot gate) refuses to start the API if any is missing or left at a
# dev placeholder, so a misconfigured deploy fails loudly instead of taking money it
# cannot fulfil. go_live.sh validates the same rules before it boots anything.

# --- Environment ---
ASPNETCORE_ENVIRONMENT=Production

# SQLite catalogue + orders db. Use an absolute path on a persistent volume.
ConnectionStrings__DefaultConnection=Data Source=/var/lib/store/store.db

# --- Stripe (LIVE) ---
# Secret key from the Stripe dashboard (LIVE mode). Must start with sk_live_.
Stripe__ApiKey=sk_live_REPLACE_ME
# Signing secret of the LIVE webhook endpoint you register at
# https://dashboard.stripe.com/webhooks (events: checkout.session.completed,
# charge.refunded, charge.dispute.created). Must start with whsec_.
Stripe__WebhookSecret=whsec_REPLACE_ME
# Active provider. Set to stripe to route the money path through Stripe.
payments__active_provider=stripe

# --- Engine -> Store publish auth (must NOT be the dev placeholders) ---
# Strong random secrets, e.g. `openssl rand -hex 32`. The engine uses the SAME
# values to authenticate to /internal/catalog and /entitlements.
Store__InternalApiKey=REPLACE_ME_openssl_rand_hex_32
Store__EntitlementsApiKey=REPLACE_ME_openssl_rand_hex_32

# --- Public URLs / CORS ---
# These are TWO DIFFERENT HOSTS and the distinction is load-bearing. The storefront serves
# the pages a buyer sees; this API serves the magic-link and download routes.
#
# The storefront origin allowed to call this API (no trailing slash).
STORE_ALLOWED_ORIGIN=https://your-storefront-domain
# Where a buyer is sent after paying. MUST be the STOREFRONT: /orders/success and /pack/{id}
# are Next.js pages that this API does not serve, so pointing this at the API host sends every
# paying customer to a 404. Defaults to STORE_ALLOWED_ORIGIN when unset.
STORE_STOREFRONT_URL=https://your-storefront-domain
# This API's public base URL. Used to address the magic-link download emails, which resolve
# against the API's own /orders/{token} route — so this one IS the API host.
STORE_PUBLIC_URL=https://your-api-domain

# --- Fulfilment email (Mailjet) ---
# Without these the API still takes money and the storefront success page still delivers the
# download, but NO confirmation email is sent and the buyer has no way back to their purchase
# once they close the tab. The API logs DELIVERY-DEGRADED at boot when they are missing.
# The From address must be a Mailjet-verified sender on a verified domain, or Mailjet rejects
# the send. Mailjet authenticates with a key PAIR: the API key is the Basic-auth username and
# the secret is the password — setting one without the other reads as unconfigured.
MAILJET_API_KEY=REPLACE_ME
MAILJET_API_SECRET=REPLACE_ME
MAILJET_FROM_EMAIL=orders@your-storefront-domain

# --- Content storage (Cloudflare R2) ---
# Without these, packs register UNLISTED (never sold undeliverably). Required to deliver.
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET=prospector-packs

# ---------------------------------------------------------------------------------------------
# Set on prospector-store-api and, until 2026-08-20, written down nowhere.
#
# Found by `scripts/estate_inventory.py`, which lists the secrets the app actually holds and
# compares them to this file. Ten were live and undescribed. The two that matter most:
# Jwt__SigningKeyPem signs every session, and Authentication__Google__ClientSecret is the other
# half of social login — restore the API without them and it starts, serves, and cannot log a
# single customer in. Nothing about that failure points at a missing secret.
#
# Names only. Values live in the encrypted store (deploy/secrets.sh), never here.
# ---------------------------------------------------------------------------------------------

# Session signing and identity. A new keyring or a new signing key logs every customer out.
Data__KeyRingPath=
Jwt__Issuer=
Jwt__Audience=
Jwt__SigningKeyPem=

# Social login. Both halves are needed; the client id alone is not enough to complete a sign-in.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# Guard rails. KnownNetworks is what the API trusts as a proxy, so a wrong value here either
# rejects real traffic or believes a forged client address.
Security__KnownNetworks=
RateLimiting__PermitPerMinute=
Founder__Emails=

# The price id the scheduled buy-a-pack proof uses. Without it the end-to-end money drill
# cannot run, and the first thing to notice would be a customer.
Stripe__SmokeTestPriceId=
