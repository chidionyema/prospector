<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      Pinned to an explicit band, NOT `latest-recommended`. With TreatWarningsAsErrors=true
      and no global.json, `latest` meant "whichever SDK the machine happens to have", so the
      hard gate moved on its own: on 2026-07-31 the SAME commit built with 0 errors on the
      local SDK 9.0.101 and failed with 10 CA1873 errors on the CI runner's 9.0.316. A gate
      that turns red with no commit behind it teaches everyone to ignore it. Raising this
      band is now a deliberate commit that fixes whatever the new rules find, in one place,
      instead of an unrelated PR discovering it.
    -->
    <AnalysisLevel>9.0-recommended</AnalysisLevel>
    <RunAnalyzers>true</RunAnalyzers>
    <!--
      CA1716: naming (identifiers should not match keywords)
      CA1707: naming (identifiers should not contain underscores)
      CA1848: use LoggerMessage delegates (micro-perf, skipped for simplicity in v1)
      CA1873: don't evaluate log arguments if logging is disabled — same family as CA1848
              and excluded on the same grounds. Every hit is in MoneyRailConfigGate, which
              runs once at startup and throws immediately after logging; there is no hot
              path to protect. Wrapping ten money-rail failure paths in IsEnabled() guards
              would add branches to the code that decides whether the app may take payments,
              to save allocations that happen at most once per process.
      S1075: URIs should not be hardcoded (false positives on prefixes)
    -->
    <NoWarn>$(NoWarn);CA1716;CA1707;CA1848;CA1873;S1075</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AsyncFixer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
