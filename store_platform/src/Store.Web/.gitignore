# Next.js / Node build artifacts and dependencies
# No trailing slash: `/node_modules/` matches a DIRECTORY only, so a symlink named node_modules
# is not ignored and `git add -A` commits it. That happened on 2026-08-01 — an absolute symlink
# into a developer's home directory reached main, where it breaks any other checkout: Turbopack
# refuses it with "Symlink [project]/node_modules is invalid, it points out of the filesystem root".
/node_modules
/.next/
/out/
*.tsbuildinfo
next-env.d.ts

# Playwright smoke (prove_web.sh) artifacts
/test-results/
/playwright-report/
/.playwright/

# UI quality tooling output. Both are reports about a run, not source: the Storybook build is
# 8.9MB of bundled assets and the Lighthouse reports are one JSON per URL per run. CI keeps them
# as artefacts of the job that produced them, which is where a report belongs.
/storybook-static/
/.lighthouseci/
