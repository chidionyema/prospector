{
  "name": "store-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "audit:gate": "node ../../scripts/audit_gate.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run lint:css",
    "test": "vitest run",
    "parity:components": "node scripts/component_parity.mjs",
    "parity:pixels": "node scripts/visual_regression.mjs",
    "test:e2e": "playwright test --project=chromium",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual-mobile --project=visual-desktop",
    "test:visual:update": "playwright test --project=visual-mobile --project=visual-desktop --update-snapshots",
    "test:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.90.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.7.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@pact-foundation/pact": "^16.5.0",
    "@playwright/test": "^1.60.0",
    "@storybook/nextjs-vite": "^10.5.9",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-tailwindcss": "^4.3.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "storybook": "^10.5.9",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0",
    "@lhci/cli": {
      "tmp": "^0.2.7"
    }
  }
}
