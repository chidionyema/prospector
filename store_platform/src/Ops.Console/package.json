{
  "name": "ops-console",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "dev": "PROSPECTOR_PYTHON=\"${PROSPECTOR_PYTHON:-$(cd ../../.. && pwd)/.venv/bin/python}\" next dev -p 8611",
    "lint": "eslint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "start": "PROSPECTOR_PYTHON=\"${PROSPECTOR_PYTHON:-$(cd ../../.. && pwd)/.venv/bin/python}\" next start -p 8611",
    "test": "vitest run",
    "test:a11y": "playwright test --project=a11y",
    "test:e2e": "playwright test --project=phone-390 --project=phone-320",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run test"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-tailwindcss": "^4.3.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
