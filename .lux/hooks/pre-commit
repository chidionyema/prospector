#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# POPDD pre-commit gate — Prospector
#   rewired 2026-06-26 (estate Phase 1) — staged-delta scope, real receipts
#   rewired 2026-08-05 — lane-aware: the proof must cover the diff
#
# WHY THE FIRST REWRITE (proven failure modes of the old ci-gate.sh path):
#   1. Schema mismatch: ci-gate.sh only counted receipts with action=='verify'
#      (per-function), but the only working producer (popdd_verify.py) emits
#      action=='test-run:complete'. The gate could never see a receipt the
#      project actually produces -> green theater.
#   2. Branch-vs-main lockout: ci-gate.sh diffed merge-base(HEAD,main)..HEAD, i.e.
#      the WHOLE branch, blocking 100% of commits on a feature branch.
#
# WHY THE SECOND REWRITE (2026-08-05), both holes proven before the fix:
#   1. This file matched `\.(py|ts|js|cs)$` — no `.tsx`. Every Next.js page under
#      store_platform/src/Store.Web committed with the gate printing
#      "nothing to prove". 183 tracked .ts/.tsx files, ungated.
#   2. Adding `.tsx` alone would have been green theatre, because the gate ran
#      exactly one proof: the python pytest suite. No python test reads a
#      .ts/.tsx file (`grep -rn "\.tsx\?[\"']" tests/ --include='*.py'` -> no
#      output), so a green pytest is not evidence about storefront code.
#
# WHAT THIS GATE ENFORCES NOW:
#   - Looks only at the STAGED delta of THIS commit (no branch lockout).
#   - popdd_verify.py --staged classifies that delta into lanes and runs each
#     lane's OWN proof, signing a receipt per lane into .lux/receipts/:
#         python  -> pytest                       (~175s)
#         web     -> tsc --noEmit + vitest        (~16s, Store.Web)
#         dotnet  -> dotnet test Store.Tests      (~47s)  [+ python: a .cs edit
#                    can break tests/unit/test_facets.py:141, which reads PackFacets.cs]
#   - A staged source file that no lane covers BLOCKS, naming the file. An
#     unproven file is not a passing file.
#   - Commit is BLOCKED unless every selected lane is green and the chain is valid.
#
# THE EXTENSION MAP LIVES IN ONE PLACE ONLY — scripts/popdd_verify.py:lanes_for().
# It used to be duplicated here as a grep, which is how `.tsx` went missing for
# months. tests/unit/test_popdd_gate_lanes.py binds this file to that function.
#
# LIMITATION (stated, not hidden): this proves "the lane's suite is green at
# commit time", not per-function POPDD. Tighten later with `lux spec verify <fn>`
# + action=='verify' receipts. `.css` under Store.Web is still uncovered — no
# cheap local proof exists for it short of a full `next build`.
# Bypass is `--no-verify` (logged by git as a choice).
#
# Install:  ln -sf ../../.lux/hooks/pre-commit .git/hooks/pre-commit
# ─────────────────────────────────────────────────────────────────────────────
set -eu

cd "$(git rev-parse --show-toplevel)" || exit 1

# Test override hook (used by the gate's own self-test to prove the BLOCK path
# without breaking the real suite). Unset in normal operation.
VERIFY_CMD="${POPDD_VERIFY_CMD:-.venv/bin/python scripts/popdd_verify.py --staged}"

if sh -c "$VERIFY_CMD"; then
  echo "─────────────────────────────────────────────────────────"
  echo "✅ POPDD gate PASSED — every lane covering this diff is green, receipts"
  echo "   signed into .lux/receipts/. Commit allowed."
  exit 0
else
  echo "─────────────────────────────────────────────────────────"
  echo "❌ POPDD gate BLOCKED this commit — a lane covering this diff did not pass"
  echo "   (or a staged source file has no lane, or the chain is invalid)."
  echo "   Fix the failure and the receipt will prove green."
  echo "   (Emergency override, recorded as a deliberate choice: git commit --no-verify)"
  exit 1
fi
